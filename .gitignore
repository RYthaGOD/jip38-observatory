node_modules/
.env
*.log

# Working state and bulky archives stay out of git.
data/*
data/claims/

# ...but the two files a clean checkout NEEDS to rebuild the page do not.
#
# `data/` used to be ignored wholesale, so a fresh clone could not run
# build-dashboard.mjs at all: the snapshot it reads was never in the repository.
# A release that cannot be rebuilt from its own source is not reproducible.
#
# The treasury series is also evidence rather than scratch — it is the only
# record of what the balance was on a given date, and it is deliberately never
# back-filled, so losing it cannot be undone.
!data/snapshot.json
!data/history.jsonl

# Derived output. Rebuild it with: node snapshot.mjs && node build-dashboard.mjs
dist/

# Rollback payloads and lock files are runtime state, not source.
*.prev
*.lock
*.tmp
data-seed/

# The reconstructed ledger. 18MB, and regenerable from chain by anyone who
# runs track.mjs — which is the point the README makes about the chain being
# its own archive. The durable record of what a crawl found is the
# reconciliation in FINDINGS.md and the assessment it supports, not this file.
EVENTS.tsv
